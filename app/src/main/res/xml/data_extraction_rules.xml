<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer rules for Android 12 and newer.
   Crash logs and the debug CLI output stay on the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="crash_logs/" />
        <exclude domain="file" path="debug_cli_output.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="crash_logs/" />
        <exclude domain="file" path="debug_cli_output.txt" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11. Crash logs and the debug CLI output
   stay on the device. Settings and user preferences are backed up.
-->
<full-backup-content>
    <exclude domain="file" path="crash_logs/" />
    <exclude domain="file" path="debug_cli_output.txt" />
</full-backup-content>
